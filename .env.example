# The FCS Guys - Supabase Backend Configuration
# Copy this file to .env.local and populate with your Supabase project credentials.

# Public Supabase API Settings (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (CRITICAL: Server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional Direct PostgreSQL Connection String (for migrations / CLI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

