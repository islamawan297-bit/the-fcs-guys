# The FCS Guys - Supabase Backend Configuration
# Copy this file to .env.local and populate with your Supabase project credentials.

# Public Supabase API Settings (Safe for client-side / browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (CRITICAL: Server-side only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
